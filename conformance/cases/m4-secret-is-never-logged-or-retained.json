{
  "id": "m4-secret-is-never-logged-or-retained",
  "kind": "management",
  "contractVersion": "1.0",
  "guarantee": "M3",
  "title": "A revealed token is returned to the caller and kept nowhere else",
  "why": "Issuing or rotating is the one response that carries a live token, and the server marks it response-only: its own String() prints '[credential redacted]'. If the SDK lets that value reach a log line, an error message, or a retained field, it undoes the one protection the server built deliberately. The caller gets it once, from the return value, and nothing else in the SDK holds it.",

  "calls": [
    { "method": "command", "args": { "command": "issue", "botID": "bot:b1", "expectedRevision": 5 } }
  ],

  "exchanges": [
    {
      "expect": {
        "method": "POST",
        "path": "/bot-management/commands",
        "body": { "command": "issue", "botID": "bot:b1", "expectedRevision": 5, "value": "$absent" }
      },
      "respond": { "status": 200, "body": { "ok": true, "data": {
        "event": { "revision": 6, "step": "bot_menu", "draft": {}, "receipt": { "operationID": "22222222-2222-4222-8222-222222222222", "botID": "bot:b1", "credentialVersion": 1, "state": "completed" }, "messageCode": "credential_issued", "createdAt": "2026-09-09T12:00:00Z" },
        "secret": { "botID": "bot:b1", "token": "bot:b1:SECRETVALUE", "version": 1 }
      } } }
    }
  ],

  "assert": {
    "secretReturnedOnce": "bot:b1:SECRETVALUE",
    "secretNotIn": ["errors", "warnings", "repr"]
  },
  "run": { "timeoutMs": 3000 }
}
