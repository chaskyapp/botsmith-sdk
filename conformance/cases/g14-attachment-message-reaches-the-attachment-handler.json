{
  "id": "g14-attachment-message-reaches-the-attachment-handler",
  "contractVersion": "1.0",
  "guarantee": "G14",
  "title": "A message whose content is an attachment reaches the attachment handler whole, never the text handler with an empty text",
  "why": "A person who sends a PDF or a photo to a bot sends no text: the server delivers text \"\" and puts what they typed, if anything, in caption. An SDK that has no field for attachments hands the text handler an empty string, and the bot answers a document with \"You said: \" or crashes on it; that is what the first SDK did in the manual test of 2026-11-27. Every field of every attachment has to arrive, because the bot needs url to fetch the file and kind and mime_type to decide what to do with it. attachments_truncated is the only way the bot learns that a message had more than the ten files it was given. A file_id that looks numeric stays a string, like every identifier in the contract (G9), and a file of exactly 100 MB, the server's limit, reports its size intact.",
  "bot": {
    "transport": "polling",
    "options": {
      "limit": 50,
      "timeoutSeconds": 25
    },
    "handler": {
      "kind": "reply",
      "replyText": "text handler ran",
      "recordAttachments": true
    }
  },
  "exchanges": [
    {
      "expect": {
        "method": "POST",
        "path": "/bot{token}/getUpdates",
        "body": {
          "offset": 0
        }
      },
