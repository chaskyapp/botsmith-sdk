{
  "id": "m1-omits-optionals-never-sends-null",
  "kind": "management",
  "contractVersion": "1.0",
  "guarantee": "M1",
  "title": "An unset optional field is omitted from the body, not sent as null",
  "why": "The server's decoder rejects a null even where the field is optional, and each language defaults differently: Python serialises None as null, JavaScript keeps an explicit null, Go omits a nil pointer. Without this case the three SDKs would send three different bodies and two of them would get 400 INVALID_INPUT for a call the author wrote correctly.",

  "calls": [
    { "method": "command", "args": { "command": "/newbot", "expectedRevision": 0 } }
  ],

  "exchanges": [
    {
      "expect": {
        "method": "POST",
        "path": "/bot-management/commands",
        "headers": { "Content-Type": "application/json" },
        "body": {
          "operationID": "$any",
          "expectedRevision": 0,
          "command": "/newbot",
          "value": "$absent",
          "botID": "$absent",
          "expectedCredentialVersion": "$absent"
        }
      },
      "respond": { "status": 200, "body": { "ok": true, "data": {
        "event": { "revision": 1, "step": "new_name", "draft": {}, "receipt": { "operationID": "11111111-1111-4111-8111-111111111111", "state": "pending" }, "messageCode": "ask_name", "createdAt": "2026-09-09T12:00:00Z" }
      } } }
    }
  ],

  "assert": { "errorsReported": [] },
  "run": { "timeoutMs": 3000 }
}
