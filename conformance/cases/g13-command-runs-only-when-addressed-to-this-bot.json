        "body": {
          "ok": true,
          "result": {
            "message_id": "r3",
            "from": {
              "id": "bot:b1",
              "name": "Pepi",
              "is_bot": true
            },
            "chat": {
              "id": "c-group",
              "type": "group",
              "title": "Grupo Test"
            },
            "date": 1795800093,
            "text": "/help@other_bot"
          }
        }
      }
    },
    {
      "expect": {
        "method": "POST",
        "path": "/bot{token}/sendMessage",
        "body": {
          "chat_id": "c-group",
          "text": "/help@"
        }
      },
      "respond": {
        "status": 200,
        "body": {
          "ok": true,
          "result": {
            "message_id": "r4",
            "from": {
              "id": "bot:b1",
              "name": "Pepi",
              "is_bot": true
            },
            "chat": {
              "id": "c-group",
              "type": "group",
              "title": "Grupo Test"
            },
            "date": 1795800094,
            "text": "/help@"
          }
        }
      }
    },
    {
      "expect": {
        "method": "POST",
        "path": "/bot{token}/sendMessage",
        "body": {
          "chat_id": "c-group",
          "text": "Help text."
        }
      },
      "respond": {
        "status": 200,
        "body": {
          "ok": true,
          "result": {
            "message_id": "r5",
            "from": {
              "id": "bot:b1",
              "name": "Pepi",
              "is_bot": true
            },
            "chat": {
              "id": "c-group",
              "type": "group",
              "title": "Grupo Test"
            },
            "date": 1795800095,
            "text": "Help text."
          }
        }
      }
    },
    {
      "expect": {
        "method": "POST",
        "path": "/bot{token}/getUpdates",
        "body": {
          "offset": 6
        }
      },
      "respond": {
        "status": 200,
        "body": {
          "ok": true,
          "result": []
        }
      },
      "repeat": true
    }
  ],
  "assert": {
    "botStopped": false,
    "errorsReported": []
  },
  "run": {
    "timeoutMs": 3000
  }
}
