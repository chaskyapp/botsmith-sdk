            "message_id": "r2",
            "from": {
              "id": "bot:b1",
              "name": "Pepi",
              "is_bot": true
            },
            "chat": {
              "id": "c-group",
              "type": "group",
              "title": "Grupo Test"
            },
            "date": 1795800092,
            "text": "Help text."
          }
        }
      }
    },
    {
      "expect": {
        "method": "POST",
        "path": "/bot{token}/sendMessage",
        "body": {
          "chat_id": "c-group",
          "text": "/help@other_bot"
        }
